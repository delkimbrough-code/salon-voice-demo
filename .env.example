# Salon identity (used in AI greetings and calendar events)
SALON_NAME=SalonAnswer Demo Salon

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Vapi
VAPI_API_KEY=

# OpenAI (used by Vapi as the AI brain)
OPENAI_API_KEY=

# Google OAuth2 — filled in by running: npm run authorize
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Set this after deploying to Render, then run: npm run setup
BACKEND_URL=https://your-app.onrender.com

# Local server port
PORT=3000
